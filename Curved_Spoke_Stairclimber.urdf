<?xml version="1.0"?>
<robot name="curved_spoke_stairclimber">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.8 0.3 0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.8 0.3 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.1 0 0" rpy="0 0 0"/>
      <mass value="3.63"/>
      <inertia ixx="0.0276" iyy="0.1572" izz="0.1847"/>
    </inertial>
  </link>

  <link name="left_curved_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.57 0 0"/>
      <mass value="0.69"/>
      <inertia ixx="0.004426" iyy="0.004426" izz="0.008555" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="-1.57 0 0"/>
      <geometry>
        <mesh filename="/Users/liranz/Downloads/curvedspokemesh v6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57 0 0"/>
      <geometry>
        <mesh filename="/Users/liranz/Downloads/curvedspokemesh v6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="right_curved_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.57 0 0"/>
      <mass value="0.69"/>
      <inertia ixx="0.004426" iyy="0.004426" izz="0.008555" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="-1.57 0 0"/>
      <geometry>
        <mesh filename="/Users/liranz/Downloads/curvedspokemesh v6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57 0 0"/>
      <geometry>
        <mesh filename="/Users/liranz/Downloads/curvedspokemesh v6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_curved_wheel"/>
    <origin xyz="-0.35 -0.2 0.015" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_curved_wheel"/>
    <origin xyz="-0.35 0.2 0.015" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>
</robot>